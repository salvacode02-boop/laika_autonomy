Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.7
      Topic: {Value: /map, Durability Policy: Transient Local, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Alpha: 0.4
      Color Scheme: costmap
      Topic: {Value: /global_costmap/costmap, Durability Policy: Transient Local, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Alpha: 0.6
      Color Scheme: costmap
      Topic: {Value: /local_costmap/costmap, Durability Policy: Transient Local, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Size (m): 0.05
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Topic: {Value: /scan, Reliability Policy: Best Effort}
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Color: 0; 200; 0
      Topic: {Value: /plan, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Path
      Name: Local plan
      Enabled: true
      Color: 0; 100; 255
      Topic: {Value: /local_plan, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/PoseArray
      Name: AMCL particles
      Enabled: true
      Color: 255; 170; 0
      Topic: {Value: /particlecloud, Reliability Policy: Best Effort}
    - Class: rviz_default_plugins/Marker
      Name: cmd_vel
      Enabled: true
      Topic: {Value: /laika/cmd_vel_marker}
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic: {Value: /initialpose}
    - Class: rviz_default_plugins/SetGoal
      Topic: {Value: /goal_pose}
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 80
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
